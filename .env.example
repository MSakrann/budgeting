DATABASE_URL=postgres://budget:budget@postgres:5432/budget
SESSION_SECRET=replace-me
# Set Secure on the session cookie when true (also on when NODE_ENV=production).
# Production deployments need TLS terminating in front of the app.
COOKIE_SECURE=false
# Force serverless-friendly Postgres pooling (also on automatically when VERCEL=1).
POSTGRES_POOL=false
# On Vercel, workbook import is skipped by default (cold-start timeout). Set true to import once.
SEED_CONSUMPTION=false
EDITOR_ONE_EMAIL=editor.one@orange.com
EDITOR_ONE_PASSWORD=replace-me
EDITOR_ONE_NAME=Editor One
EDITOR_TWO_EMAIL=editor.two@orange.com
EDITOR_TWO_PASSWORD=replace-me
EDITOR_TWO_NAME=Editor Two
VIEWER_EMAIL=cto@orange.com
VIEWER_PASSWORD=replace-me
VIEWER_NAME=CTO
CONSUMPTION_XLSX=references/Data - List of POs 2026.xlsx
