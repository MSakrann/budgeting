{
  "buildCommand": "npm run build && npm run vercel:prepare",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/session.ts": {
      "maxDuration": 60
    },
    "api/[...route].ts": {
      "maxDuration": 60,
      "includeFiles": "references/**"
    }
  }
}
